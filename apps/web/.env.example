# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
OPENAI_API_KEY=
# ---- Provisioning required (Anthropic Console: console.anthropic.com) ----
ANTHROPIC_API_KEY=

# GitHub - existing PAT (used by background sync scripts/webhooks)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# ---- Provisioning required: create a GitHub OAuth App at
#      github.com/settings/developers, callback URL
#      <NEXT_PUBLIC_APP_URL>/api/github/callback ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Provisioning required: Google Cloud Console OAuth client (Calendar
#      + Classroom scopes), callback URL
#      <NEXT_PUBLIC_APP_URL>/api/auth/google/callback ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Provisioning required: resend.com API key for transactional email ----
RESEND_API_KEY=

# ---- Provisioning required: 32-byte hex key for AES-256-GCM encryption of
#      OAuth tokens at rest, e.g. `openssl rand -hex 32` ----
ENCRYPTION_KEY=

# apps/ai-service (FastAPI) link
# ---- Provisioning required once ai-service is deployed (Step 6) ----
AI_SERVICE_URL=
AI_SERVICE_SECRET=

# Analytics / error tracking (optional but recommended)
POSTHOG_KEY=
SENTRY_DSN=

NEXT_PUBLIC_APP_URL=

# Background jobs
APIFY_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_PAYMENT_LINK=

# Job board sources
ADZUNA_APP_ID=
ADZUNA_API_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=
FINDWORK_API_KEY=
USAJOBS_API_KEY=
THEMUSE_API_KEY=
JOBDATALAKE_API_KEY=
